{
  "name": "dms-material-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/dms-material-e2e/src",
  "implicitDependencies": ["dms-material"],
  "// targets": "to see all targets run: nx show project dms-material-e2e --web",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx e2e-chromium dms-material-e2e",
          "nx e2e-firefox dms-material-e2e"
        ],
        "parallel": false
      }
    },
    "e2e-chromium": {
      "command": "playwright test --project=chromium --config=apps/dms-material-e2e/playwright.config.ts"
    },
    "e2e-firefox": {
      "command": "playwright test --project=firefox --config=apps/dms-material-e2e/playwright.config.ts"
    },
    "e2e-electron": {
      "command": "playwright test --project=electron --config=apps/dms-material-e2e/playwright.config.ts",
      "dependsOn": [
        {
          "projects": ["electron"],
          "target": "build:linux"
        }
      ]
    },
    "e2e-electron-smoke": {
      "command": "playwright test --project=electron-smoke --config=apps/dms-material-e2e/playwright.config.ts",
      "dependsOn": [
        {
          "projects": ["electron"],
          "target": "build:linux"
        }
      ]
    },
    "e2e-electron-env-guard": {
      "command": "playwright test --project=electron-env-guard --config=apps/dms-material-e2e/playwright.config.ts",
      "dependsOn": [
        {
          "projects": ["electron"],
          "target": "build:linux"
        }
      ]
    },
    "e2e-ui": {
      "command": "playwright test --project=chromium --ui --config=apps/dms-material-e2e/playwright.config.ts"
    }
  }
}
